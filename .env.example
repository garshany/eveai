# Bot platforms: fill in at least one token (both may run at once).

# Telegram
# Create a bot with @BotFather. Long polling is used; do not configure webhooks.
TELEGRAM_BOT_TOKEN=
# Optional proxy for Telegram API, for example socks5h://127.0.0.1:10808
TELEGRAM_PROXY=
TELEGRAM_TIMEOUT_SECONDS=20
# Optional allowlist. Set 0 to allow any private Telegram user.
ALLOWED_TELEGRAM_USER_ID=0
# Shared ingress controls (the historical TELEGRAM_ prefix also governs Discord).
TELEGRAM_REQUEST_WINDOW_MS=60000
TELEGRAM_MAX_REQUESTS_PER_WINDOW=6
TELEGRAM_MAX_ACTIVE_REQUESTS_GLOBAL=8
# Drop queued updates on boot (true) or redeliver messages sent while the bot
# was down (false, default - no silent loss on deploy/restart).
TELEGRAM_DROP_PENDING_UPDATES=false
# Skip redelivered updates older than this many minutes (0 disables).
TELEGRAM_MAX_UPDATE_AGE_MINUTES=15
# Button taps carry no press time and cannot be age-checked, so a tap is honoured
# only when its keyboard was sent by the running process; taps on keyboards from
# before a restart answer "send the command again". No knob — see RELIABILITY.md.

# Discord
# Create an application at https://discord.com/developers/applications,
# add a bot, and invite it to your server. No privileged intents are needed.
# The bot answers in DMs (напиши ему в личные сообщения).
DISCORD_BOT_TOKEN=
# Optional allowlist: a Discord user id (snowflake). Empty = allow any user.
ALLOWED_DISCORD_USER_ID=

# Responses provider. IDs map to fixed transports/endpoints; OPENAI_BASE_URL is ignored.
# Provider choices: openai | modelhub
OPENAI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Model choices: gpt-5.6-sol | gpt-5.6-terra | gpt-5.6-luna (gpt-5.6 aliases Sol).
# stateless = rebuild context from SQLite on every turn (default/rollback).
# server = OpenAI-only previous_response_id continuation; requires store=true.
# ModelHub is an OpenAI-compatible proxy and requires stateless.
OPENAI_RESPONSE_STATE_MODE=stateless
# Opt in to OpenAI Dashboard Logs and API retrieval of stored Responses.
# Stored requests may include chat context and tool outputs. Keep false unless
# the operator accepts OpenAI's applicable data-retention policy.
OPENAI_STORE_RESPONSES=false
# Default-off hosted Programmatic Tool Calling for nine bounded public-read tools.
# Only true or false are valid. Enable only for an entitled model/project;
# false plus restart is the immediate no-migration rollback switch.
OPENAI_PROGRAMMATIC_TOOL_CALLING=false
# Application-managed read subagents. They receive only the
# nine bounded public-read facades and no chat history, private ESI, or writes.
# ModelHub defaults this to true; OpenAI defaults it to false and supports
# an explicit opt-in through this legacy-named flag.
# CHEAPVIBE_READ_SUBAGENTS_ENABLED=true
CHEAPVIBE_READ_SUBAGENT_CONCURRENCY=4
# Read-subagent budgets (per delegated batch / shared per turn).
CHEAPVIBE_READ_SUBAGENT_MAX_TASKS=8
CHEAPVIBE_READ_SUBAGENT_MAX_WORKERS=6
CHEAPVIBE_READ_SUBAGENT_MAX_WORKER_ITERATIONS=8
CHEAPVIBE_READ_SUBAGENT_MAX_MODEL_CALLS=24
CHEAPVIBE_READ_SUBAGENT_AGGREGATE_CHARS=60000
CHEAPVIBE_READ_SUBAGENT_BATCH_DEADLINE_MS=600000
# auto uses the local goal classifier; fixed values override it for normal chat turns.
# Reasoning effort: auto | none | low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=auto
# Optional per-iteration effort tiers for the agent tool loop. auto (default)
# inherits OPENAI_REASONING_EFFORT, so unset tiers change nothing. Set
# INTERMEDIATE to a cheaper effort to cut reasoning spend on tool-chain
# continuations; INTERMEDIATE=low with FINAL=auto is a safe first A/B step.
# OPENAI_REASONING_EFFORT_INTERMEDIATE=auto
# OPENAI_REASONING_EFFORT_FINAL=auto
# Reasoning mode: standard | pro. Pro is slower and can consume more tokens.
OPENAI_REASONING_MODE=standard
# Text verbosity: low | medium | high. Low fits chat-sized answers.
OPENAI_TEXT_VERBOSITY=low
# Increase deliberately for Pro/quality-first requests that may exceed 90 seconds.
OPENAI_RESPONSES_TIMEOUT_MS=300000
# One wall-clock limit for the complete root turn, including retries and tools.
AGENT_TURN_DEADLINE_MS=600000
# Per-tool output budget in chars, sized against OPENAI_MODEL_CONTEXT_WINDOW.
AGENT_MAX_TOOL_OUTPUT_CHARS=120000
# Arrays smaller than this reach the model verbatim (within the char budget).
AGENT_SMART_AGGREGATE_THRESHOLD=200
AGENT_MAX_PROGRAMMATIC_TOOL_OUTPUT_CHARS=120000
# Stateless per-turn context loaded from SQLite.
AGENT_MAX_CONTEXT_MESSAGES=40
AGENT_MAX_CONTEXT_CHARS=100000
# Tool-loop iteration ceiling (loop protection, also bounded by the deadline).
AGENT_MAX_TOOL_ITERATIONS=80
# Anti-loop nudge threshold for identical consecutive tool calls.
AGENT_MAX_CONSECUTIVE_SAME_TOOL=5
AGENT_MAX_CLIENT_SEARCH_CALLS_PER_RESPONSE=8
AGENT_MAX_EVE_KILL_CALLS_PER_TURN=60
AGENT_MAX_EVE_KILL_ANALYTICS_CALLS_PER_TURN=12
AGENT_MAX_TRANSIENT_RETRIES=5
# Shared read-leaf ceiling across the root turn and delegated subagents.
AGENT_MAX_TOTAL_TURN_READ_LEAVES=96
# Single-process provider backpressure for public multi-user traffic.
OPENAI_MAX_CONCURRENT_RESPONSES=8
OPENAI_MAX_QUEUED_RESPONSES=32
OPENAI_RESPONSE_QUEUE_TIMEOUT_MS=15000
# Bound leaf public-read fan-out across all users; writes/UI are globally serialized.
AGENT_MAX_CONCURRENT_READ_TOOLS=16
# Global cap for nested CCP ESI requests created by batch facades.
AGENT_MAX_CONCURRENT_ESI_LEAVES=12
AGENT_MAX_QUEUED_TOOLS=64
AGENT_TOOL_QUEUE_TIMEOUT_MS=15000
# Default answer language for final user-facing responses. Examples: ru, русский, en, English.
OPENAI_RESPONSE_LANGUAGE=Russian
OPENAI_MAX_OUTPUT_TOKENS=0
OPENAI_COMPACT_THRESHOLD=0
# Local compaction budget, not a provider-advertised model limit.
OPENAI_MODEL_CONTEXT_WINDOW=200000

# EVE SSO
# Register an application at https://developers.eveonline.com/ and use the callback below for local dev.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
# Required outside throwaway local testing. Generate with: openssl rand -base64 32
AUTH_SECRET_KEY=
EVE_CALLBACK_URL=http://localhost:3000/auth/eve/callback
SSO_REQUEST_TIMEOUT_MS=8000

# ESI
ESI_BASE_URL=https://esi.evetech.net/latest/
ESI_SPEC_URL=https://esi.evetech.net/latest/swagger.json
ESI_CATALOG_CACHE_PATH=./data/cache/esi-swagger.json
ESI_COMPATIBILITY_DATE=2026-03-15
# Replace contact= with your reachable operator contact before running a public instance.
ESI_USER_AGENT=EVEAI/4.0 (+https://github.com/example/eveai; contact=operator@example.com)
ESI_MAX_PAGES=50
# Pagination budget for the assets_summary aggregator only (private asset lists
# routinely exceed the generic budget; 25 pages = 25k asset rows).
ESI_ASSETS_MAX_PAGES=200
# market_wide_summary whole-market sweep budgets: own fan-out concurrency
# (on top of the shared AGENT_MAX_CONCURRENT_ESI_LEAVES admission), a safety
# cap on swept trade regions, and a per-region order-book page budget.
ESI_MARKET_WIDE_CONCURRENCY=12
ESI_MARKET_WIDE_MAX_REGIONS=500
ESI_MARKET_WIDE_MAX_PAGES=50
ESI_BACKOFF_MAX_SECONDS=10
ESI_REQUEST_TIMEOUT_MS=30000
ESI_RETRY_MAX_ATTEMPTS=5

# Market snapshot worker (local whole-market copy paged straight from ESI).
# A cron tick every 5 minutes refetches only the regions whose tier interval
# elapsed and carries the rest over locally; the swap is atomic.
MARKET_SNAPSHOT_ENABLED=true
# Insert batch size. 2000 measured ~135 MB peak RSS on the 2 GB production VM
# (20k rows/batch spiked to 306 MB next to the agent).
MARKET_SNAPSHOT_BATCH_SIZE=2000
# Two-tier freshness classified by page count (never by region name): regions
# whose book spans at least this many 1000-order pages refetch on the major
# interval, the long tail on the minor one. 100 currently catches exactly
# The Forge, Domain, Sinq Laison and Metropolis — about half of all orders.
MARKET_SNAPSHOT_MAJOR_MIN_PAGES=100
# Never below ESI's own 5-minute order-book cache.
MARKET_SNAPSHOT_MAJOR_INTERVAL_MINUTES=30
MARKET_SNAPSHOT_MINOR_INTERVAL_MINUTES=360
# Grace allowance past a region's OWN tier interval before its rows read as
# stale: a healthy minor-tier book is legitimately hours old, so the threshold
# sits on top of the interval instead of replacing it.
MARKET_SNAPSHOT_STALE_MINUTES=75
# Page fan-out inside one region's walk. 8 walks The Forge's ~410 pages in
# ~10-15 s — far inside ESI's 5-minute cache window, so last-modified cannot
# flip mid-walk. Keep it small: the walker bypasses the agent's ESI admission
# controller and shares the IP rate/error budget with interactive calls.
MARKET_SNAPSHOT_PAGE_CONCURRENCY=8

# Character datastore sync (private profile mirrored into local character_* tables)
# Page ceiling for full-profile syncs (assets, wallet journal). 50 pages x 1000 rows
# bounds the wallet journal at 50k entries per character.
CHARACTER_SYNC_MAX_PAGES=50
# Freshness fallback when ESI omits Expires on a synced dataset.
CHARACTER_SYNC_FALLBACK_TTL_SECONDS=3600
# Backoff before retrying a dataset whose last sync failed.
CHARACTER_SYNC_ERROR_RETRY_SECONDS=120

# Server (EVE SSO callback, optional browser chat, and health endpoint)
PORT=3000
HOST=127.0.0.1
WEB_BASE_URL=http://localhost:3000
# Explicit opt-in: enables same-origin React app and anonymous browser sessions.
WEB_CHAT_ENABLED=false
# Comma-separated proxy CIDRs. Empty means forwarded address headers are ignored.
# For a local Cloudflare Tunnel connector use loopback only; for a direct edge
# deployment use the exact current Cloudflare egress ranges and firewall origin ingress.
WEB_TRUSTED_PROXY_CIDRS=
# Browser session lifetime, bounded to 1..8760 hours.
WEB_SESSION_TTL_HOURS=720
# Bound anonymous-session creation per client address before rows reach SQLite.
WEB_SESSION_CREATION_WINDOW_SECONDS=600
WEB_MAX_SESSION_CREATIONS_PER_WINDOW=30
# Durable async web-agent queue and rolling admission limits.
WEB_MAX_CONCURRENT_AGENT_REQUESTS=8
WEB_MAX_QUEUED_AGENT_REQUESTS=64
WEB_MAX_QUEUED_AGENT_REQUESTS_PER_USER=5
WEB_REQUEST_WINDOW_SECONDS=60
WEB_MAX_REQUESTS_PER_USER_WINDOW=6
WEB_MAX_REQUESTS_GLOBAL_WINDOW=120
WEB_MAX_REQUESTS_GLOBAL_DAY=10000
# One accepted root turn reserves four conservative compute units (root + bounded subagents).
WEB_MAX_COST_UNITS_PER_USER_WINDOW=24
WEB_MAX_COST_UNITS_GLOBAL_WINDOW=480
WEB_MAX_COST_UNITS_GLOBAL_DAY=40000
WEB_AGENT_DEADLINE_MS=600000
WEB_REQUEST_RETENTION_DAYS=7
# Natural-language market item picker. Disable to switch the feature off
# without touching the chat; budgets bound model calls per search.
WEB_AI_SEARCH_ENABLED=true
WEB_AI_SEARCH_MAX_MODEL_CALLS=2
WEB_AI_SEARCH_TIMEOUT_MS=30000
WEB_AI_SEARCH_MAX_RESULTS=20
# Optional locally; mandatory for a public production WEB_BASE_URL.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Database and local generated data
DB_PATH=./data/eve-agent.db
SDE_DATA_DIR=./data/sde
USER_PROFILE_PATH=./data/USER_{chat_id}_{character_id}.md
USER_PROFILE_REFRESH_SECONDS=300
DEFAULT_MARKET_REGION_ID=10000002
DEFAULT_MARKET_REGION_NAME="The Forge"

# Local market price history worker. ESI /markets/{region}/history/ is rebuilt
# once a day at 11:05 UTC; the hourly tick drains pairs due for a refresh.
MARKET_HISTORY_ENABLED=true
# Due pairs synced per tick (watchlist plus seeded top types).
MARKET_HISTORY_MAX_PER_TICK=100
# Concurrent unauthenticated ESI history calls in flight.
MARKET_HISTORY_CONCURRENCY=4
# Additionally seed the top-N types by listed value in major regions (0 = watchlist only).
MARKET_HISTORY_SEED_TOP_TYPES=200

# One-shot price alerts evaluated against the local market snapshot every 5 minutes.
MARKET_ALERTS_ENABLED=true
# Cap on simultaneously active alerts per user (1..200).
MARKET_ALERTS_MAX_ACTIVE_PER_USER=50

# Optional web search (https://tavily.com)
TAVILY_API_KEY=

# Community EVE APIs: EVE Ref industry cost, zKillboard stats, MutaMarket
# abyssal listings, optional Janice appraisal. One shared retry/timeout budget.
# Empty JANICE_API_KEY disables the Janice second opinion (the local appraisal
# from the market snapshot still works). Base URLs are overridable for tests.
EVEREF_BASE_URL=https://api.everef.net
ZKILL_BASE_URL=https://zkillboard.com
MUTAMARKET_BASE_URL=https://mutamarket.com
JANICE_BASE_URL=https://janice.e-351.com
JANICE_API_KEY=
COMMUNITY_API_TIMEOUT_MS=12000
COMMUNITY_API_RETRY_MAX_ATTEMPTS=3
COMMUNITY_API_BACKOFF_MAX_MS=8000

# EVE-KILL
# Positive values only. Timeout/backoff are capped at 60000 ms; attempts at 5.
EVE_KILL_TIMEOUT_MS=8000
EVE_KILL_USER_AGENT=EVEAI/4.0 (+https://github.com/example/eveai; contact=operator@example.com)
EVE_KILL_RETRY_MAX_ATTEMPTS=3
EVE_KILL_BACKOFF_MAX_MS=10000

# EVE-Scout
EVE_SCOUT_BASE_URL=https://api.eve-scout.com/v2/public/
EVE_SCOUT_TIMEOUT_MS=8000
EVE_SCOUT_CACHE_TTL_SECONDS=300
EVE_SCOUT_USER_AGENT=EVEAI/4.0 (+https://github.com/example/eveai; contact=operator@example.com)
EVE_SCOUT_RETRY_MAX_ATTEMPTS=2
EVE_SCOUT_BACKOFF_MAX_MS=5000

# Prompt/history compaction
COMPACT_MAX_INPUT_CHARS=20000

# --- Donations & cost transparency -------------------------------------------
# External Boosty page for donations. No acquiring: we only render this link.
# Default is the confirmed production page. Set explicitly empty (BOOSTY_URL=)
# to hide the donate button entirely.
BOOSTY_URL=https://boosty.to/artemy1337
# Token tariffs, USD per 1M tokens keyed by model id. The provider does not
# publish prices, so cost is computed locally; models without an entry are
# reported as "cost unknown" (never as 0). Rates: uncached input, visible
# output, cached input, reasoning. Unset/empty keeps the built-in defaults
# (the owner's current tariffs, see DEFAULT_MODEL_PRICING_JSON in config.ts);
# a non-empty value replaces the whole table.
# MODEL_PRICING_JSON={"gpt-5.6-sol": {"input": 0.06825, "output": 0.34125, "cached": 0.0126, "reasoning": 0.34125}}
MODEL_PRICING_JSON=
# Raw per-response usage events are pruned after this many days (daily
# aggregates are kept forever). Bounds 2..365.
USAGE_EVENTS_RETENTION_DAYS=30
# Public cache lifetime of GET /api/web/transparency in seconds (0 = no-store).
TRANSPARENCY_PUBLIC_CACHE_SECONDS=60
# Optional RUB display next to USD. Both must be set together; the rate is
# never fetched — you pin it, and the page labels it with this date.
# USD_RUB_RATE=95.40
# USD_RUB_RATE_DATE=2026-07-27
# Static infrastructure monthly figure shown only while no live billing
# export is read (from the owner's measurements of the current setup).
INFRA_ESTIMATE_USD_MONTHLY=19
# GCP actuals via the Cloud Billing export to BigQuery (the Cloud Billing API
# itself serves only the SKU price list, not real spend). All four must be set
# together; all empty = "export not configured" (the page then shows the
# estimate above). The key is a service-account JSON with BigQuery Data Viewer
# + BigQuery Job User on the project. See
# .agent/tasks/donations-20260727/GCP-BILLING-EXPORT-SETUP.md
GCP_BILLING_PROJECT_ID=
GCP_BILLING_DATASET=
GCP_BILLING_TABLE=
GCP_BILLING_SERVICE_ACCOUNT_KEY_PATH=
# The export lags hours behind; hourly background refresh is plenty.
# Reads never happen inside HTTP handlers.
GCP_BILLING_REFRESH_TTL_MS=3600000
GCP_BILLING_QUERY_TIMEOUT_MS=10000

# Graceful shutdown: how long to wait for in-flight turns to finish and reply
# before exiting (0 = exit immediately, ceiling 3600000). The default matches
# the default AGENT_TURN_DEADLINE_MS so a default-length turn always fits; an
# idle stop exits at once, so the wait only ever happens mid-turn. Keep your
# supervisor's stop timeout above this — deploy/systemd/eveai.service sets
# TimeoutStopSec=660 for the default, and raising one without the other means
# SIGKILL mid-drain.
SHUTDOWN_DRAIN_MS=600000
SHUTDOWN_DRAIN_POLL_MS=250
