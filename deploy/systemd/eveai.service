[Unit]
Description=EVE AI Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust these paths for your server before installing.
User=eveai
Group=eveai
WorkingDirectory=/srv/eveai
EnvironmentFile=/srv/eveai/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /srv/eveai/dist/app.js
Restart=always
RestartSec=5
# Shutdown budget — these three numbers must move together:
#   AGENT_TURN_DEADLINE_MS (default 600s, ceiling 3600s) bounds one agent turn;
#   SHUTDOWN_DRAIN_MS    (default 600s, ceiling 3600s) bounds how long a stop
#                        waits for in-flight turns to answer;
#   TimeoutStopSec       must stay strictly ABOVE the configured drain,
#                        otherwise systemd SIGKILLs the process mid-drain and
#                        the in-flight answers are lost anyway.
# Keep: turn deadline <= drain < TimeoutStopSec. The 60s headroom here covers
# the post-drain market-sweep stop (up to 30s), connection and SQLite teardown. Raising AGENT_TURN_DEADLINE_MS
# past 600s without raising the other two reintroduces the mid-turn kill.
TimeoutStopSec=660
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The checkout, package metadata, and built code remain read-only. Runtime
# state and the adjacent single-process lock live under this explicit path.
ReadWritePaths=/srv/eveai/data

[Install]
WantedBy=multi-user.target
